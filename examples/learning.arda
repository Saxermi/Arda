tol ad
tol numc as nc
# Fit y = 2*x + 1 from four points using reverse-mode autodiff and Adam.
esta xs = [0, 1, 2, 3]
esta ys = [1, 3, 5, 7]
esta params = nc.zeros(2)
esta m = nc.zeros(2)
esta v = nc.zeros(2)
esta step = 1
tenna step <= 400:
    esta w = ad.variable(params[0])
    esta b = ad.variable(params[1])
    esta loss = 0
    esta i = 0
    tenna i < len(xs):
        esta e = w * xs[i] + b - ys[i]
        loss = loss + e * e / len(xs)
        i = i + 1
    ad.backward(loss)
    esta g = nc.array([ad.grad(w), ad.grad(b)])
    esta state = ad.adam(params, g, m, v, step, 0.05)
    params = state[0]
    m = state[1]
    v = state[2]
    step = step + 1
pedo("Learned slope:", params[0])
pedo("Learned intercept:", params[1])
esta residuals = params[0] * nc.array(xs) + params[1] - nc.array(ys)
pedo("MSE:", nc.mean(residuals * residuals))

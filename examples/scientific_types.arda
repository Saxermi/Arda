tol lowrank as lr
tol tensor as t
tol units as u

esta left = t.array([1, 2], "float64", [2, 1])
esta right = t.array([3, 4, 5], "float64", [3, 1])
esta grid = t.contract(lr.cp([left, right]), [2, mun], "float64")
pedo(lr.at(grid, [1, 2]), lr.norm(grid))

esta speed = u.quantity(72, "km/h")
esta time = u.quantity(30, "min")
pedo(u.value(speed * time, "km"))
esta outside = u.quantity(68, "degF")
pedo(u.value(outside - u.quantity(5, "degC"), "deltaC"))

esta spec = t.spec([3000000000, 2], "float64")
pedo(spec["elements"], spec["bytes"], spec["materializable"])

caro entry(x, i):
    nan x[i + 1]

pedo(entry.getTex())

tol numc as nc
tol high
tol linop as l
tol solver as s
tol ode

# 3D Poisson equation, zero Dirichlet boundary, unit grid spacing.
esta op = l.poisson([32,32,32])
esta rhs = nc.ones(32768)
esta result = s.solve("cg",op,rhs,{"tol":1e-8,"maxiter":500})
pedo("3D unknowns:", nc.bytes(rhs)/8)
pedo("CG iterations:", result["iterations"], "relative residual:", result["residual"], "converged:", result["converged"])
pedo("Recomputed residual:", s.verify(op,rhs,result["solution"])["residual"])

# Four-dimensional tensor problem, manufactured solution.
esta op4 = l.poisson([8,8,8,8])
esta exact = nc.ones(4096)
esta r4 = s.solve("cg",op4,l.apply(op4,exact),{"tol":1e-9,"maxiter":200})
pedo("4D unknowns:", nc.bytes(exact)/8, "relative solution error:", nc.norm(r4["solution"]-exact)/nc.norm(exact))

# 1000 simultaneous decay equations, with different decay rates.
esta rate = nc.linspace(1,2,1000)
caro decay(t,y):
    nan 0-rate*y
esta sim = ode.rk45(decay, 0, nc.ones(1000), 1, 0.5, 0.00000001, 0.0000000001)
pedo("ODE unknowns:", 1000, "accepted:", sim["accepted_steps"], "rejected:", sim["rejected_steps"])
pedo("ODE max error:", nc.max(nc.sqrt((sim["solution"]-nc.exp(0-rate))*(sim["solution"]-nc.exp(0-rate)))))

# Nonlinear-optimizer API: weighted quadratic objective in 10,000 variables.
tol opt
esta target = nc.linspace(-1,1,10000)
esta weight = nc.linspace(1,10,10000)
caro objective(x):
    esta d = x-target
    nan {"value": 0.5*high.inner(d,weight*d), "gradient": weight*d}
esta best = opt.lbfgs(objective,nc.zeros(10000),0.000001,300,10)
pedo("Optimization unknowns:", 10000, "iterations:", best["iterations"], "gradient norm:", best["gradient_norm"], "converged:", best["converged"])
pedo("Optimization error:", nc.norm(best["solution"]-target))

# Actual eight-dimensional tensor: 4^8 = 65,536 unknowns.
esta shape8 = [4,4,4,4,4,4,4,4]
esta u8 = nc.reshape(nc.ones(65536),shape8)
esta op8 = l.poisson(shape8)
esta rhs8 = l.apply(op8,nc.reshape(u8,[65536]))
esta r8 = s.solve("cg",op8,rhs8,{"tol":1e-9,"maxiter":200})
pedo("8D unknowns:",nc.bytes(u8)/8,"iterations:",r8["iterations"],"relative residual:",r8["residual"],"converged:",r8["converged"])
pedo("8D relative solution error:",nc.norm(nc.reshape(r8["solution"],shape8)-u8)/nc.norm(u8))

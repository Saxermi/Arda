tol ode
tol pde
tol numc as n
tol ad

# Fixed sampling times and the first half-life.
caro decay(t,y):
    nan -y
caro half_life(t,y):
    nan y-0.5
esta trajectory = ode.rk45(decay,0,1.0,2,0.3,1e-9,1e-12,1000,
    {"saveat":[0,0.25,0.5],"events":[{"fn":half_life,"direction":-1,"terminal":nae}],
     "checkpoint":nae})
pedo("Half-life",trajectory["time"],"saved states",trajectory["states"])
esta resumed = ode.rk45_resume(decay,trajectory["checkpoint"],1)
pedo("Resumed decay error",abs(resumed["solution"]-ad.exp(-1)))

# A stiff forced problem with exact solution cos(t).
caro stiff(t,y):
    nan -1000*(y-cos(t))-sin(t)
caro jacobian(t,y):
    nan -1000
esta stiff_result = ode.radau(stiff,0,1.0,1,0.02,{"jacobian":jacobian})
pedo("Stiff steps",stiff_result["accepted_steps"],"error",abs(stiff_result["solution"]-cos(1)))

# Two-dimensional heat equation on a square with zero Dirichlet data.
esta side = 256
esta h = 1.0/(side+1)
esta pi = 3.141592653589793
esta mode = n.sin(pi*n.linspace(h,1-h,side))
esta field = n.reshape(n.reshape(mode,[side,1])*n.reshape(mode,[1,side]),[side*side])
esta grid = pde.grid([side,side],h)
esta start = monotonic()
esta heat = pde.heat(grid,field,0.001,0.1,0.0005)
esta elapsed = monotonic()-start
esta exact = ad.exp(-0.001*2*pi*pi*0.1)*field
esta error = n.norm(heat["solution"]-exact)/n.norm(exact)
pedo("Heat",side,"by",side,"steps",heat["steps"],"CFL",heat["cfl"])
pedo("Relative heat error",error,"seconds",elapsed)
qui error > 1e-6:
    throw {"code":"verification","message":"heat example exceeded the analytic error bound"}

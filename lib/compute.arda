tol _compute as _native
tol tensor as _tensor
tol linalg as _linalg

esta memory_stats = _native.memory_stats
esta memory_budget = _native.memory_budget
esta trim_pool = _native.trim_pool
esta plan = _native.plan
esta stream_stats = _native.stream_stats
esta cpu = _native.cpu
esta matmul_kernel = _native.matmul_kernel
esta vector_math = _native.vector_math
esta threads = _native.threads
esta tiled_matmul = _native.tiled_matmul
esta axpy = _native.axpy
esta mul_add = _native.mul_add
esta fused_products = _native.fused_products
esta map_reduce = _native.map_reduce
esta explain = _native.explain
esta execute = _native.execute
esta run = _native.run
esta report = _native.report
esta capabilities = _native.capabilities
esta last_run = _native.last_run
esta compare = _native.compare
esta topology = _native.topology
esta affinity = _native.affinity
esta first_touch = _native.first_touch
esta file_matmul = _native.file_matmul
esta file_spmv = _native.file_spmv
esta file_qr_r = _native.file_qr_r
esta file_rsvd_right = _native.file_rsvd_right

caro file_svd_right(source, block_rows = mun):
    esta r = file_qr_r(source,block_rows)
    esta factors = _linalg.svd(r)
    nan [factors[1],factors[2]]

caro _callable(f):
    esta kind = type(f)
    nan kind == "function" or kind == "native" or kind == "method"

caro _collect_consumed_blocks():
    # Finish any active cycle, then reclaim blocks marked before they were dropped.
    collect()
    collect()

caro reduce_file(source, initial, step, block_elements = 65536):
    qui not _callable(step):
        throw {"code":"type","message":"file reducer must be callable"}
    esta blocks = _tensor.blocks(source,block_elements)
    esta accumulator = initial
    try:
        an block in blocks:
            accumulator = step(accumulator,block)
            block = mun
            _collect_consumed_blocks()
    catch error:
        _tensor.close_blocks(blocks)
        throw error
    _tensor.close_blocks(blocks)
    nan accumulator

caro _filter_block(block, predicate, dtype):
    esta kept = []
    an value in _tensor.tolist(block):
        esta selected = predicate(value)
        qui type(selected) != "bool":
            throw {"code":"type","message":"file filter predicate must return a Boolean"}
        qui selected:
            push(kept,value)
    nan _tensor.array(kept,dtype)

caro _write_transformed_file(source, destination, callback, filter, dtype, block_elements, disk_budget):
    qui not _callable(callback):
        throw {"code":"type","message":"file transform must be callable"}
    esta blocks = _tensor.blocks(source,block_elements)
    esta output = mun
    esta offset = 0
    try:
        esta info = _tensor.file_info(blocks)
        esta shape = info["shape"]
        qui filter:
            shape = [info["elements"]]
            dtype = info["dtype"]
        elif dtype == mun:
            dtype = info["dtype"]
        output = _tensor.open_output(destination,shape,dtype,disk_budget)
        an block in blocks:
            esta tile = mun
            qui filter:
                tile = _filter_block(block,callback,dtype)
            ai:
                tile = callback(block)
            esta tile_shape = _tensor.shape(tile)
            qui len(tile_shape) != 1 or (not filter and tile_shape[0] != _tensor.shape(block)[0]):
                throw {"code":"shape","message":"file map must return a vector of the same length"}
            _tensor.write_block(output,offset,tile)
            offset = offset + tile_shape[0]
            block = mun
            tile = mun
            _collect_consumed_blocks()
        qui filter:
            _tensor.truncate_output(output,offset)
        _tensor.commit_output(output)
    catch error:
        qui output != mun:
            _tensor.abort_output(output)
        _tensor.close_blocks(blocks)
        throw error
    _tensor.close_blocks(blocks)
    nan offset

caro map_file(source, destination, callback, dtype = mun, block_elements = 65536, disk_budget = mun):
    nan _write_transformed_file(source,destination,callback,law,dtype,block_elements,disk_budget)

caro filter_file(source, destination, predicate, block_elements = 65536, disk_budget = mun):
    nan _write_transformed_file(source,destination,predicate,nae,mun,block_elements,disk_budget)

caro _sweep_config(options):
    esta config = {"max_cases":10000,"max_errors":100,"stream":mun,"factor":mun}
    qui options != mun:
        qui type(options) != "map":
            throw {"code":"type","message":"sweep options must be a map"}
        an key in keys(options):
            esta value = options[key]
            qui key == "stream":
                qui value != mun and not _callable(value):
                    throw {"code":"type","message":"sweep stream must be callable"}
            elif key == "factor":
                qui value != mun and type(value) != "factor":
                    throw {"code":"type","message":"sweep factor must be a linear algebra factor"}
            elif key == "max_cases" or key == "max_errors":
                qui type(value) != "int" or value < 0 or value > 1000000:
                    throw {"code":"domain","message":"sweep limits must be integers in 0..1000000"}
            ai:
                throw {"code":"domain","message":"unknown sweep option: " + key}
            config[key] = value
    nan config

# The VM schedules one case at a time. Native kernels can use their own teams.
caro sweep(cases, run, options = mun):
    qui not _callable(run) or (type(cases) != "list" and type(cases) != "range"):
        throw {"code":"type","message":"sweep expects a list or range and a callable"}
    esta config = _sweep_config(options)
    qui len(cases) > config["max_cases"]:
        throw {"code":"sweep_limit","message":"sweep case count exceeds max_cases"}
    qui type(cases) == "list":
        cases = cases[:]
    esta stream = config["stream"]
    esta factor = config["factor"]
    esta results = []
    esta errors = []
    esta failed = 0
    esta index = 0
    an item in cases:
        esta value = mun
        esta ok = nae
        try:
            qui factor == mun:
                value = run(item)
            ai:
                value = run(item,factor)
        catch error:
            value = error
            ok = law
        esta row = {"index":index,"ok":ok}
        qui ok:
            row["result"] = value
            qui stream == mun:
                push(results,row)
        ai:
            row["error"] = value
            failed = failed + 1
            qui len(errors) < config["max_errors"]:
                push(errors,{"index":index,"error":value})
        qui stream != mun:
            stream(row)
        index = index + 1
    nan {"results":results,"errors":errors,"succeeded":index-failed,"failed":failed,
         "errors_truncated":failed > len(errors)}

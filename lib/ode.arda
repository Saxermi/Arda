# Uniform-grid composite Simpson integration and classical RK4.
caro integrate(f, a, b, n = 100):
    qui type(n) != "int" or n < 2 or n % 2 != 0 or n > 1000000:
        throw "Simpson needs an even interval count 2..1000000"
    esta h = (b - a) / n
    esta s = f(a) + f(b)
    esta i = 1
    tenna i < n:
        qui i % 2 == 0:
            s = s + 2 * f(a + i * h)
        ai:
            s = s + 4 * f(a + i * h)
        i = i + 1
    nan s * h / 3

caro rk4(f, t0, y0, h, steps):
    qui type(steps) != "int" or steps < 1 or steps > 100000:
        throw "RK4 needs 1..100000 steps"
    esta t = t0
    esta y = y0
    esta out = [y]
    esta i = 0
    tenna i < steps:
        esta k1 = f(t, y)
        esta k2 = f(t + h / 2, y + h * k1 / 2)
        esta k3 = f(t + h / 2, y + h * k2 / 2)
        esta k4 = f(t + h, y + h * k3)
        y = y + h * (k1 + 2 * k2 + 2 * k3 + k4) / 6
        push(out, y)
        i = i + 1
        t = t0 + i * h
    nan out

# Dormand-Prince 5(4), forward/backward integration, returns final state and counters.
# Uses weighted RMS local error, with componentwise absolute/relative tolerances.
tol numc as _nc
tol ad as _ad
tol high as _high
caro rk45(f, t0, y0, t1, h, rtol = 0.000001, atol = 0.000000001, maxiter = 100000):
    qui (h <= 0 or rtol <= 0 or atol <= 0 or maxiter < 1 or type(maxiter) != "int"):
        throw "invalid RK45 configuration"
    qui not _high.finite(t0) or not _high.finite(t1) or not _high.finite(h) or not _high.finite(rtol) or not _high.finite(atol) or not _high.finite(y0):
        throw "nonfinite RK45 configuration"
    esta t = t0
    esta y = y0
    esta accepted = 0
    esta rejected = 0
    esta direction = 1
    qui t1 < t0:
        direction = -1
    h = h * direction
    tenna direction * (t1 - t) > 0:
        qui accepted + rejected >= maxiter:
            throw "RK45 step limit"
        qui abs(h) > abs(t1 - t):
            h = t1 - t
        qui t + h == t:
            throw "RK45 step underflow"
        esta k1 = f(t, y)
        esta k2 = f(t + h/5, y + h*(k1/5))
        esta k3 = f(t + 3*h/10, y + h*(3*k1/40 + 9*k2/40))
        esta k4 = f(t + 4*h/5, y + h*(44*k1/45 - 56*k2/15 + 32*k3/9))
        esta k5 = f(t + 8*h/9, y + h*(19372*k1/6561 - 25360*k2/2187 + 64448*k3/6561 - 212*k4/729))
        esta k6 = f(t + h, y + h*(9017*k1/3168 - 355*k2/33 + 46732*k3/5247 + 49*k4/176 - 5103*k5/18656))
        esta z = y + h*(35*k1/384 + 500*k3/1113 + 125*k4/192 - 2187*k5/6784 + 11*k6/84)
        esta k7 = f(t + h, z)
        esta low = y + h*(5179*k1/57600 + 7571*k3/16695 + 393*k4/640 - 92097*k5/339200 + 187*k6/2100 + k7/40)
        esta err = _high.rkerror(y,z,low,rtol,atol)
        qui err != err:
            throw "RK45 nonfinite error"
        qui err <= 1:
            y = z
            t = t + h
            accepted = accepted + 1
        ai:
            rejected = rejected + 1
        esta factor = 5
        qui err > 0:
            # exp(-log(err)/5), via built-in scalar AD functions
            factor = 0.9*_ad.exp(-_ad.log(err)/5)
        qui factor < 0.2:
            factor = 0.2
        qui factor > 5:
            factor = 5
        h = h * factor
    nan [y, accepted, rejected]
